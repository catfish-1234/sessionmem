{
  "name": "sessionmem",
  "version": "1.4.0",
  "private": false,
  "type": "module",
  "description": "Local-first MCP memory layer for coding agents across Claude Code, Codex, Cursor, Cline, Windsurf, and other MCP-compatible hosts.",
  "license": "MIT",
  "author": "kavishdua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catfish-1234/sessionmem.git"
  },
  "mcpName": "io.github.catfish-1234/sessionmem",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    ".github/sessionmem-logo.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sessionmem": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.mjs",
    "prepack": "npm run build",
    "test": "vitest run --reporter=dot",
    "test:schema": "vitest run tests/integration/storage/schema.spec.ts --reporter=dot",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "benchmark": "node scripts/benchmark.mjs",
    "version": "node scripts/sync-version.mjs && git add package/package.json .claude-plugin/plugin.json server.json Dockerfile",
    "postversion": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^14.0.3",
    "js-tiktoken": "^1.0.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "bugs": {
    "url": "https://github.com/catfish-1234/sessionmem/issues"
  },
  "homepage": "https://github.com/catfish-1234/sessionmem#readme"
}
