{
  "name": "sessionmem",
  "version": "2.3.1",
  "private": false,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/api/client.d.ts",
      "import": "./dist/api/client.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "description": "Local-first MCP memory layer for coding agents across Claude Code, Codex, Cursor, Cline, Windsurf, and other MCP-compatible hosts.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "memory",
    "ai-memory",
    "persistent-memory",
    "long-term-memory",
    "claude-code",
    "claude",
    "codex",
    "cursor",
    "cline",
    "windsurf",
    "copilot",
    "ai-agents",
    "coding-agent",
    "context",
    "local-first",
    "sqlite",
    "privacy"
  ],
  "license": "MIT",
  "author": "kavishdua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catfish-1234/sessionmem.git"
  },
  "mcpName": "io.github.catfish-1234/sessionmem",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    ".github/sessionmem-logo.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sessionmem": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.mjs",
    "prepack": "npm run build",
    "test": "vitest run --reporter=dot",
    "test:schema": "vitest run tests/integration/storage/schema.spec.ts --reporter=dot",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "benchmark": "node scripts/benchmark.mjs",
    "release": "node scripts/release.mjs",
    "version": "node scripts/sync-version.mjs && git add package/package.json .claude-plugin/plugin.json server.json Dockerfile",
    "postversion": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.2.0",
    "commander": "^15.1.0",
    "js-tiktoken": "^1.0.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/tokenizers": "0.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@xcidos/genesis-memory-model": "0.1.0-alpha.1",
    "eslint": "^10.12.0",
    "globals": "^17.14.0",
    "onnxruntime-node": "1.31.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bugs": {
    "url": "https://github.com/catfish-1234/sessionmem/issues"
  },
  "homepage": "https://github.com/catfish-1234/sessionmem#readme",
  "peerDependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@xcidos/genesis-memory-model": "0.1.0-alpha.1",
    "onnxruntime-node": "1.31.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/tokenizers": {
      "optional": true
    },
    "onnxruntime-node": {
      "optional": true
    },
    "@xcidos/genesis-memory-model": {
      "optional": true
    }
  }
}
